{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.juntai.io/capability/evidence-pointer/v1.schema.json",
  "title": "EvidencePointer v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "evidenceId", "ownerDomain", "evidenceKind", "target", "read", "selectors", "observedAt", "access"],
  "properties": {
    "schemaVersion": {"const": "1"},
    "evidenceId": {"type": "string", "minLength": 1, "maxLength": 200},
    "ownerDomain": {"type": "string", "minLength": 1},
    "evidenceKind": {"type": "string", "minLength": 1},
    "target": {
      "oneOf": [
        {"type": "object", "additionalProperties": false, "required": ["kind", "resourceId"], "properties": {"kind": {"const": "resource"}, "resourceId": {"type": "string"}}},
        {"type": "object", "additionalProperties": false, "required": ["kind", "artifactRef"], "properties": {"kind": {"const": "artifact"}, "artifactRef": {"type": "object", "minProperties": 3}}}
      ]
    },
    "read": {"$ref": "#/$defs/publicRead"},
    "selectors": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["selectorId", "valueType", "value"],
        "properties": {
          "selectorId": {"type": "string"},
          "valueType": {"enum": ["string", "integer", "number", "boolean", "timestamp"]},
          "value": {"type": ["string", "integer", "number", "boolean"]}
        }
      }
    },
    "applicationScope": {"type": "object", "additionalProperties": false, "required": ["applicationId"], "properties": {"applicationId": {"type": "string"}, "applicationVersionId": {"type": "string"}}},
    "observedAt": {"type": "string", "format": "date-time"},
    "consistencyWindow": {"type": "object", "additionalProperties": false, "required": ["fromInclusive", "toExclusive"], "properties": {"fromInclusive": {"type": "string", "format": "date-time"}, "toExclusive": {"type": "string", "format": "date-time"}}},
    "traceId": {"type": "string", "maxLength": 128},
    "correlationId": {"type": "string", "maxLength": 128},
    "causationId": {"type": "string", "maxLength": 128},
    "access": {
      "type": "object",
      "additionalProperties": false,
      "required": ["authorizationPolicyId", "delegatedCallerRequired", "requiredScopes", "allowedPurposes", "dataClassification"],
      "properties": {
        "authorizationPolicyId": {"type": "string"},
        "delegatedCallerRequired": {"const": true},
        "requiredScopes": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
        "allowedPurposes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
        "dataClassification": {"enum": ["public", "internal", "confidential", "restricted"]},
        "expiresAt": {"type": "string", "format": "date-time"},
        "revocation": {
          "type": "object",
          "additionalProperties": false,
          "required": ["authority", "handle", "statusRead"],
          "properties": {"authority": {"type": "string"}, "handle": {"type": "string"}, "statusRead": {"$ref": "#/$defs/publicRead"}}
        }
      }
    }
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "toolRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["toolId", "mcpDescriptorDigest", "signatureSha256", "inputSchemaDigest"],
      "properties": {
        "toolId": {"type": "string"}, "mcpDescriptorDigest": {"$ref": "#/$defs/digest"}, "signatureSha256": {"$ref": "#/$defs/digest"}, "inputSchemaDigest": {"$ref": "#/$defs/digest"}, "outputSchemaDigest": {"$ref": "#/$defs/digest"}, "approvalPolicyUnitId": {"type": "string"}
      }
    },
    "publicRead": {
      "oneOf": [
        {"type": "object", "additionalProperties": false, "required": ["protocol", "serviceId", "operationId", "openapiDigest"], "properties": {"protocol": {"const": "openapi"}, "serviceId": {"type": "string"}, "operationId": {"type": "string"}, "openapiDigest": {"$ref": "#/$defs/digest"}}},
        {"type": "object", "additionalProperties": false, "required": ["protocol", "tool"], "properties": {"protocol": {"const": "mcp"}, "tool": {"$ref": "#/$defs/toolRef"}}}
      ]
    }
  }
}
