{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.juntai.io/capability/content-graph/v1.schema.json",
  "title": "CapabilityContentGraph v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "bundle", "units", "edges", "contracts", "provenance"],
  "properties": {
    "schemaVersion": {"const": "1"},
    "bundle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ownerKey", "bundleId", "version", "schemaMajor"],
      "properties": {
        "ownerKey": {"$ref": "#/$defs/id"},
        "bundleId": {"$ref": "#/$defs/id"},
        "version": {"type": "string"},
        "schemaMajor": {"const": 1}
      }
    },
    "units": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["unitId", "kind", "audiences", "locale", "title", "lifecycle", "content", "contentDigest", "toolReferences", "schemaReferences"],
        "properties": {
          "unitId": {"$ref": "#/$defs/id"},
          "kind": {"type": "string"},
          "audiences": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
          "locale": {"type": "string"},
          "title": {"type": "string"},
          "sourcePath": {"type": "string"},
          "parentUnitId": {"$ref": "#/$defs/id"},
          "order": {"type": "integer"},
          "lifecycle": {"type": "string"},
          "content": {"type": "string"},
          "contentDigest": {"$ref": "#/$defs/digest"},
          "toolReferences": {"type": "array", "items": {"type": "object"}},
          "schemaReferences": {"type": "array", "items": {"type": "object"}},
          "mcp": {"type": "object"}
        }
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["fromUnitId", "relation"],
        "properties": {
          "fromUnitId": {"$ref": "#/$defs/id"},
          "relation": {"enum": ["references", "requires", "explains", "invokes-tool", "uses-schema", "supersedes"]},
          "toUnitId": {"$ref": "#/$defs/id"},
          "tool": {"type": "object"},
          "schema": {"type": "object"}
        }
      }
    },
    "contracts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["openapiDigest", "mcpDescriptorDigest", "mcpServiceId", "mcpBuildId", "fuseApiVersion"],
      "properties": {
        "openapiDigest": {"$ref": "#/$defs/digest"},
        "mcpDescriptorDigest": {"$ref": "#/$defs/digest"},
        "mcpServiceId": {"type": "string"},
        "mcpBuildId": {"type": "string"},
        "fuseApiVersion": {"enum": ["2.0.0", "2.1.0"]}
      }
    },
    "provenance": {"type": "object"}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._/-]{1,199}$"},
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
  }
}
